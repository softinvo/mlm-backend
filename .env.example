PAYMENT_BANK=
PAYMENT_UPI_ID=
FUND_MIN_PAISE=10000
FUND_MAX_PAISE=5000000
FUND_MAX_OPEN=3
ADMIN_MAX=2
# Product / package pictures (Cloudflare R2 or any S3-compatible bucket). Leave blank to turn uploads off.
# The bucket must allow PUT from your admin app's origin (CORS), and STORAGE_URL is the public address the files are served from.
